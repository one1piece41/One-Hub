local function draggable(target,handle)
    local dragging = false
    local startInput, startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startInput = input.Position
            startPosition = target.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement
        ) then
            local delta = input.Position - startInput
            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

draggable(toggle,toggle)
draggable(frame,title)

toggle.Activated:Connect(function()
    frame.Visible = not frame.Visible
end)

local minimized = false
minimize.Activated:Connect(function()
    minimized = not minimized
    content.Visible = not minimized
    status.Visible = not minimized
    frame.Size = minimized
        and UDim2.fromOffset(145,27)
        or UDim2.fromOffset(145,137)
    minimize.Text = minimized and "+" or "-"
end)

local function removeESP(plr)
    local items = espObjects[plr]
    if not items then return end
    for _,obj in ipairs(items) do
        pcall(function() obj:Destroy() end)
    end
    espObjects[plr] = nil
end

close.Activated:Connect(function()
    teleEnabled = false
    espEnabled = false
    for plr in pairs(espObjects) do
        removeESP(plr)
    end
    gui:Destroy()
end)

-- SET SPOT
setBtn.Activated:Connect(function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        savedCFrame = root.CFrame
        status.Text = "Spot saved!"
    else
        status.Text = "Character not ready"
    end
end)

-- TELE ON/OFF
teleBtn.Activated:Connect(function()
    if not savedCFrame then
        status.Text = "Set spot first"
        return
    end

    teleEnabled = not teleEnabled
    teleBtn.Text = teleEnabled and "TELE: ON" or "TELE: OFF"
    status.Text = teleEnabled and "Tele ON" or "Tele OFF"

    if teleEnabled then
        task.spawn(function()
            while teleEnabled and gui.Parent do
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and savedCFrame then
                    pcall(function()
                        root.CFrame = savedCFrame
                    end)
                end
                task.wait(0.3)
            end
        end)
    end
end)

-- ESP
local function addESP(plr)
    if plr == player or not espEnabled then return end
    removeESP(plr)

    local char = plr.Character
    if not char then return end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillColor = RED
    highlight.OutlineColor = WHITE
    highlight.FillTransparency = 0.65
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = gui

    local items = {highlight}
    local head = char:FindFirstChild("Head")

    if head then
        local bill = Instance.new("BillboardGui")
        bill.Adornee = head
        bill.Size = UDim2.fromOffset(120,20)
        bill.StudsOffset = Vector3.new(0,2.5,0)
        bill.AlwaysOnTop = true
        bill.Parent = gui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1,1)
        label.BackgroundTransparency = 1
        label.Text = plr.Name
        label.TextColor3 = WHITE
        label.TextStrokeTransparency = 0
        label.TextSize = 10
        label.Font = Enum.Font.GothamBold
        label.Parent = bill
        table.insert(items,bill)
    end

    espObjects[plr] = items
end

espBtn.Activated:Connect(function()
    espEnabled = not espEnabled
    espBtn.Text = espEnabled and "ESP: ON" or "ESP: OFF"

    if espEnabled then
        for _,plr in ipairs(Players:GetPlayers()) do
            addESP(plr)
        end
        status.Text = "ESP ON"
    else
        for plr in pairs(espObjects) do
            removeESP(plr)
        end
        status.Text = "ESP OFF"
    end
end)

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled and gui.Parent then
            addESP(plr)
        end
    end)
end)

Players.PlayerRemoving:Connect(removeESP)

